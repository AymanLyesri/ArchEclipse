# Ignore all files
/*

!LICENSE

!.gitignore
!README.md
!docs

!.github

!.config/
.config/*

# Include hyprland config
!.config/hypr/
# Include foot config
!.config/foot/
# include pipwire config
!.config/pipewire/
# include fastfetch config
!.config/fastfetch/
# include starship config
!.config/starship.toml
# include btop config
!.config/btop/
# include user systemd units
!.config/systemd/
!.config/systemd/user/
.config/systemd/user/*
!.config/systemd/user/battery-check.service
!.config/systemd/user/battery-check.timer
!.config/systemd/user/updates-check.service
!.config/systemd/user/updates-check.timer
# Include archeclipse quickshell and its greeter (parent dir must be
# re-included too: git cannot re-include paths under an excluded dir)
!.config/quickshell/
!.config/quickshell/archeclipse/
!.config/quickshell/archeclipse-greeter/

# include icons (cursort theme)
!.icons/

# include zsh config
!.zshrc
# include modular zsh config (custom/ stays local-only)
!.config/zsh/
.config/zsh/custom/
