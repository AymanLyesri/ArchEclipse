# Ignore all files
/*

!LICENSE

!.gitignore
!README.md
!docs

!.github

!.config/
.config/*

# Include the user services ArchEclipse ships (the session guard has to be one:
# it exists to restart the shell after a compositor crash, and Hyprland's
# post-crash safe mode is exactly when exec-once does not run).
!.config/systemd/
!.config/systemd/user/

# Include hyprland config
!.config/hypr/
# Include kitty config
!.config/kitty/
# include pipwire config
!.config/pipewire/
# include ags
!.config/ags/
# include fastfetch config
!.config/fastfetch/
# wallpapers
!.config/wallpapers/
# include starship config
!.config/starship.toml
# include btop config
!.config/btop/

# include icons (cursort theme)
!.icons/

# include zsh config
!.zshrc
