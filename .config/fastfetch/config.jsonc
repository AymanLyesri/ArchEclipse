{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "right": 1,
    },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    // Title
    {
      "type": "title",
      "format": "{#1}╭───────────────────── {#}{user-name-colored}",
    },
    // System Information
    {
      "type": "os",
      "key": "{#separator}│  {#keys}󰍹",
    },
    {
      "type": "kernel",
      "key": "{#separator}│  {#keys}󰒋",
    },
    {
      "type": "uptime",
      "key": "{#separator}│  {#keys}󰅐",
    },
    {
      "type": "packages",
      "key": "{#separator}│  {#keys}󰏖",
      "format": "{all}",
    },
    {
      "type": "custom",
      "format": "{#1}│",
    },
    // Desktop Environment

    {
      "type": "de",
      "key": "{#separator}│  {#keys}󰧨",
    },
    {
      "type": "custom",
      "key": "{#separator}│  {#keys}󱡓",
      "format": "ArchEclipse",
    },
    {
      "type": "wm",
      "key": "{#separator}│  {#keys}󱂬",
    },
    {
      "type": "wmtheme",
      "key": "{#separator}│  {#keys}󰉼",
    },
    {
      "type": "display",
      "key": "{#separator}│  {#keys}󰹑",
    },
    {
      "type": "custom",
      "format": "{#1}│",
    },
    {
      "type": "cpu",
      "key": "{#separator}│  {#keys}󰻠",
    },
    {
      "type": "gpu",
      "key": "{#separator}│  {#keys}󰢮",
    },
    {
      "type": "memory",
      "key": "{#separator}│  {#keys}󰍛",
    },
    {
      "type": "disk",
      "key": "{#separator}│  {#keys}󰋊",
      "folders": "/",
    },
    // {
    //   "type": "custom",
    //   "format": "{#1}│",
    // },
    // {
    //   "type": "custom",
    //   "format": "{#1}│ `archeclipse` to update ArchEclipse",
    // },
    // {
    //   "type": "custom",
    //   "format": "{#1}│ `wallpapers` to install default wallpapers",
    // },
    // {
    //   "type": "custom",
    //   "format": "{#1}│ `quickspeed` to test connection",
    // },
    // Colors
    {
      "type": "colors",
      "key": "{#separator}│",
      "symbol": "circle",
    },
    // Footer
    {
      "type": "custom",
      "format": "{#1}╰───────────────────────────────────────────╯",
    },
  ],
}
